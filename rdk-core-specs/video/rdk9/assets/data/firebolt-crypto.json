    "api-0": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "generateKey",
      "firebolt-global": "Yes",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              {
                "text": "keyType - enum",
                "items": [
                  "AES128",
                  "AES256",
                  "HMAC128",
                  "HMAC160",
                  "HMAC256"
                ]
              },
              {
                "text": "keyUsage - list of enums, unordered - optional",
                "items": [
                  "ENCRYPT",
                  "DECRYPT",
                  "SIGN",
                  "DERIVE",
                  "UNWRAP"
                ]
              }
            ]
          }
        },
        {
          "label": "Returns",
          "value": "keyId - unsigned"
        },
        {
          "label": "Specific errors",
          "value": {
            "type": "list",
            "items": [
              "-xxxxa - Key Creation Error",
              "-xxxxe - Invalid File name",
              "-xxxxh - Authentication failure",
              "-xxxxd - Invalid key type"
            ]
          }
        }
      ],
      "overview": "Generate symmetric algorithm key file, load it into key store and provide handle for further access. Generated key this way shall be considered local to the application generating it - shall not be shared. Not persisted during this call. To use exportKey in case persistence is required.",
      "trailing": []
    },
    "api-1": {
      "type": "apiMethod",
      "eyebrow": "Module",
      "module": "Crypto",
      "method": "generateKeyPair",
      "firebolt-global": "Yes",
      "support": [
        {
          "label": "C++",
          "state": "supported"
        },
        {
          "label": "JS",
          "state": "not-supported"
        }
      ],
      "fields": [
        {
          "label": "Parameters",
          "value": {
            "type": "list",
            "items": [
              {
                "text": "algorithm - enum",
                "items": [
                  "AUTH_DH"
                ]
              },
              {
                "text": "Optional parameter for AUTH_DH algo:",
                "items": [
                  "primePDataOffset - unsigned",
                  "primePDataLength - unsigned",
                  "generatorGDataOffset - unsigned",
                  "generatorGDataLength - unsigned"
                ]
              },
              {
                "text": "Optional parameter for RSA algo (not supported, just for ex):",
                "items": [
                  "modulusBits - unsigned",
                  "publicExponent - unsigned"
                ]
              }
            ]
          }
        },
        {
          "label": "Returns",
          "value": {
            "type": "list",
            "items": [
              "privateKeyId - unsigned",
              "publicKeyId - unsigned"
            ]
          }
        },
        {
          "label": "Specific errors",
          "value": {
            "type": "list",
            "items": [
              "-xxxxh - Authentication failure",
              "-xxxxa - Operation failed",
              "-xxxxz / Invalid Parameters"
            ]
          }
        }
      ],
      "overview": "Create authenticated DH session keys with algorithm \"AUTH_DH\" Authenticated Diffie-Hellman. Mapping from Netflix APIs: generatorG; // from base_buf primeP; // from modulus",
      "trailing": []
    },
