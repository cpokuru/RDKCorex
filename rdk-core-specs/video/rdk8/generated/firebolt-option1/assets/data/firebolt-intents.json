          ]
        },
        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{\n \"action\": \"tune\",\n \"data\": {\n     \"entity\": {\n \"entityType\": \"channel\",\n \"channelType\": \"streaming\",\n \"entityId\": \"SkyMovies1\"\n       },\n     \"options\": {\n \"restartCurrentProgram\": true\n       }\n  },\n  \"context\": {\n \"source\": \"linear_channel\"\n }\n}",
              "variant": "spec-example"
            }
          ]
        }
      ]
    },
