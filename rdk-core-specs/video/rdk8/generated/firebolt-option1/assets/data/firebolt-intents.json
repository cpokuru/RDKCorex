          ],
          "rows": [
            {
              "name": "entity",
              "type": "object",
              "mandatory": "Yes",
              "allowedValues": {
                "type": "details",
                "summary": "entity fields",
                "blocks": [
                  {
                    "type": "table",
                    "columns": [
                      {
                        "key": "name",
                        "label": "Name"
                      },
                      {
                        "key": "type",
                        "label": "Type"
