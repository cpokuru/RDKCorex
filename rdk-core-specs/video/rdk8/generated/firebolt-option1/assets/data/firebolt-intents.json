          ],
          "rows": [
            {
              "name": "entityId",
              "type": "string",
              "mandatory": "Yes",
              "allowedValues": "Any",
              "description": "The identifier of the entity, in the target App's scope."
            },
            {
              "name": "assetId",
              "type": "string",
              "mandatory": "No",
              "allowedValues": "Any",
              "description": "The identifier of the asset, in the target App's scope."
            },
            {
              "name": "seasonId",
              "type": "string",
              "mandatory": "No",
              "allowedValues": "Any",
              "description": "The identifier of the season, in the target App's scope."
            },
            {
