              "body": "{\n \"action\": \"entity\",\n \"data\": {\n \"entityId\": \"ABC123\"\n },\n \"context\": {\n \"source\": \"continue_watching\"\n }\n}",
              "variant": "spec-example"
            },
            {
              "type": "code",
              "body": "{\n \"action\": \"entity\",\n \"data\": {\n \"entityId\": \"ABC123\",\n \"assetId\": \"asdfsa73546\",\n \"seasonId\": \"dasfasfhj786876\",\n \"seriesId\": \"dsfsf2345\",\n \"appContentData\": \"externalId_23456\",\n \"programType\": \"series\"\n  },\n \"context\": {\n \"source\": \"continue_watching\"\n }\n}",
              "variant": "spec-example"
            }
