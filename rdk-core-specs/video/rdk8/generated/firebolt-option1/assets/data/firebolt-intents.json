{
  "schemaVersion": "1.0",
  "hero": {
    "eyebrow": "Firebolt 8",
    "title": "Firebolt 8 Intents Specification",
    "description": "Intent definitions for applications to request device and content experiences through the RDK8 video platform.",
    "status": "Published"
  },
  "source": {
    "label": "Firebolt 8 Intent Spec.pdf",
    "href": "assets/pdf/Firebolt 8 Intent Spec.pdf"
  },
  "blocks": [
    {
      "type": "section",
      "blocks": [
        {
          "type": "prose",
          "body": "An Intent is a message object sent to an application requesting a specific action. This may occur as part of the launch of the application or when it is already loaded. The application shall treat the receipt of an intent as an explicit request to carry out the intent and immediately action it, irrespective of what the application is currently doing. The only exception to this if the application is carrying out some process that can not be interrupted eg processing a payment."
        },
        {
          "type": "prose",
          "body": "An application may support multiple intent action types or none, however if an application receives an intent that it does not support, or one that does not contain enough data for an application to fulfil it, it shall ignore it and not present any error to the user."
        }
      ],
      "id": "overview",
      "classes": "intent-overview"
    },
    {
      "type": "section",
      "blocks": [
        {
          "type": "table",
          "columns": [
            {
              "key": "part",
              "label": "Part"
            },
            {
              "key": "type",
              "label": "Type"
            },
            {
              "key": "mandatory",
              "label": "Mandatory"
            },
            {
              "key": "description",
              "label": "Description"
            },
            {
              "key": "allowedValues",
              "label": "Allowed values"
            }
          ],
          "rows": [
            {
              "part": "action",
              "type": "string",
              "mandatory": "Yes",
              "description": "A string specifying the implicit action being requested to be performed",
              "allowedValues": {
                "type": "actions",
                "items": [
                  {
                    "label": "home",
                    "ref": "intent-home"
                  },
                  {
                    "label": "launch",
                    "ref": "intent-launch"
                  },
                  {
                    "label": "pre-load",
                    "ref": "intent-pre-load"
                  },
                  {
                    "label": "entity",
                    "ref": "intent-entity"
                  },
                  {
                    "label": "playback",
                    "ref": "intent-playback"
                  },
                  {
                    "label": "search",
                    "ref": "intent-search"
                  },
                  {
                    "label": "section",
                    "ref": "intent-section"
                  },
                  {
                    "label": "tune",
                    "ref": "intent-tune"
                  },
                  {
                    "label": "play-entity",
                    "ref": "intent-play-entity"
                  },
                  {
                    "label": "play-query",
                    "ref": "intent-play-query"
                  },
                  {
                    "label": "previous",
                    "ref": "intent-previous"
                  },
                  {
                    "label": "next",
                    "ref": "intent-next"
                  },
                  {
                    "label": "repeat",
                    "ref": "intent-repeat"
                  },
                  {
                    "label": "shuffle",
                    "ref": "intent-shuffle"
                  },
                  {
                    "label": "skip-ad",
                    "ref": "intent-skip-ad"
                  },
                  {
                    "label": "skip-recap",
                    "ref": "intent-skip-recap"
                  },
                  {
                    "label": "skip-intro",
                    "ref": "intent-skip-intro"
                  }
                ]
              }
            },
            {
              "part": "data",
              "type": "object",
              "mandatory": "No",
              "description": "An optional object that contains data to be used by the application in order to fulfil the action"
            },
            {
              "part": "context",
              "type": "object",
              "mandatory": "Yes",
              "description": "An object defining the source of the intent and optionally properties of that source",
              "allowedValues": {
                "type": "details",
                "summary": "Context fields",
                "blocks": [
                  {
                    "type": "table",
                    "columns": [
                      {
                        "key": "name",
                        "label": "Name"
                      },
                      {
                        "key": "type",
                        "label": "Type"
                      },
                      {
                        "key": "mandatory",
                        "label": "Mandatory"
                      },
                      {
                        "key": "allowedValues",
                        "label": "Allowed values"
                      },
                      {
                        "key": "description",
                        "label": "Description"
                      }
                    ],
                    "rows": [
                      {
                        "name": "source",
                        "type": "string",
                        "mandatory": "Yes",
                        "allowedValues": "Any",
                        "description": "An undefined string indicating the source of the intent eg \"voice\""
                      },
                      {
                        "name": "agePolicy",
                        "type": "string",
                        "mandatory": "No",
                        "allowedValues": {
                          "type": "list",
                          "items": [
                            "'app: child'",
                            "'app: teen'",
                            "'app: adult'"
                          ]
                        },
                        "description": "An optional string indicating an age group that the intent is targeting. This maybe implied by the content type or from where the link was initiated from (eg Kids Rail), or from the known age of the currently selected device profile."
                      },
                      {
                        "name": "profilePolicy",
                        "type": "string",
                        "mandatory": "No",
                        "allowedValues": {
                          "type": "list",
                          "items": [
                            "childProfile",
                            "teenProfile",
                            "adultProfile",
                            "householdProfile"
                          ]
                        },
                        "description": "An optional string indicating the age group of the currently selected device profile. If a default device profile is selected, 'householdProfile' will be used, indicating no specific age group is associated with it."
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "id": "constituent-parts",
      "heading": "Constituent parts of an intent"
    }
  ],
  "definitions": {
    "intent-home": {
      "type": "entry",
      "eyebrow": "Intent action",
      "heading": "Home action type",
      "overview": "A request to action a transition to the home page of the application",
      "blocks": [
        {
          "type": "heading",
          "body": "Definition of data object"
        },
        {
          "type": "code",
          "body": "The Home action intent does not require a data object",
          "variant": "spec-definition-text"
        },
        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{\n \"action\": \"home\",\n \"context\": {\n \"source\": \"apps_rail\"\n }\n}",
              "variant": "spec-example"
            }
          ]
        }
      ]
    },
    "intent-launch": {
      "type": "entry",
      "eyebrow": "Intent action",
      "heading": "Launch action type",
      "overview": "A request to show the page the app was previously on (or Home page if it's a cold launch) of the application",
      "blocks": [
        {
          "type": "heading",
          "body": "Definition of data object"
        },
        {
          "type": "table",
          "columns": [
            {
              "key": "name",
              "label": "Name"
            },
            {
              "key": "type",
              "label": "Type"
            },
            {
              "key": "mandatory",
              "label": "Mandatory"
            },
            {
              "key": "allowedValues",
              "label": "Allowed values"
            },
            {
              "key": "description",
              "label": "Description"
            }
          ],
          "rows": [
            {
              "name": "appContentData",
              "type": "string",
              "mandatory": "No",
              "allowedValues": "Any",
              "description": "Any extra information required to launch the app eg The DIAL payload. Max size 4KB"
            }
          ]
        },
        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{\n \"action\": \"launch\",\n \"context\": {\n \"source\": \"apps_rail\"\n }\n}",
              "variant": "spec-example"
            },
            {
              "type": "code",
              "body": "{\n \"action\": \"launch\",\n  \"data\": {\n \"appContentData\": \"DIALParam1=Somestring\",\n },\n \"context\": {\n \"source\": \"DIAL\"\n }\n}",
              "variant": "spec-example"
            }
          ]
        }
      ]
    },
    "intent-pre-load": {
      "type": "entry",
      "eyebrow": "Intent action",
      "heading": "Pre-load action type",
      "overview": "A request to pre load the application, but indicates that it will not immediately be activated and is likely to be transitioned into the suspended/hibernated states",
      "blocks": [
        {
          "type": "heading",
          "body": "Definition of data object"
        },
        {
          "type": "code",
          "body": "The Pre-load action intent does not require a data object",
          "variant": "spec-definition-text"
        },
        {
          "type": "heading",
          "body": "Example"
        },
        {
          "type": "examples",
          "blocks": [
            {
              "type": "code",
              "body": "{\n \"action\": \"pre-load\",\n \"context\": {\n \"source\": \"system\"\n }\n}",
              "variant": "spec-example"
            }
          ]
        }
      ]
    },
    "intent-entity": {
      "type": "entry",
      "eyebrow": "Intent action",
      "heading": "Entity action type",
      "overview": "A request to action a transition to the entity/show page of the specified entity",
      "blocks": [
        {
          "type": "heading",
          "body": "Definition of data object"
        },
        {
          "type": "table",
          "columns": [
            {
